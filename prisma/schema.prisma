// ─── Outlet Sales History ─────────────────────────────────────────────────────
// Synced from mkt_insight.dbo.DIR10001B. One row per (kodePI × itemKode).
// totalSales12Bln = SUM([Value Sales]) for the 12 completed months before current.

model OutletSalesHistory {
  id              String   @id @default(uuid())
  kodePI          String
  itemKode        String
  totalSales12Bln Decimal  @db.Decimal(18, 2)
  periodeFrom     String // YYYYMM — start of 12-month window
  periodeTo       String // YYYYMM — end of 12-month window
  syncedAt        DateTime

  @@unique([kodePI, itemKode])
  @@index([kodePI])
  @@index([itemKode])
}

// Monthly sales QUANTITY per outlet+product — feeds the quarterly target
// calculation (ratio + productivity-equalization engine, see
// src/lib/targetCalculation.ts). Quantity, not Rupiah value — targets in
// this scheme are unit-quantity based; Rupiah value is qty × HNA, derived
// on demand from Product.hna.
model OutletSalesMonthly {
  id       String   @id @default(uuid())
  kodePI   String
  itemKode String
  periode  String // YYYYMM
  qty      Decimal  @db.Decimal(18, 2)
  syncedAt DateTime

  @@unique([kodePI, itemKode, periode])
  @@index([kodePI])
  @@index([itemKode])
  @@index([periode])
}

// Outlet-level (not per-product) monthly Rupiah sales value from
// mkt_insight.dbo.DIR10001B — feeds the Detail POA page's "Data Sales" card
// (Historis [tahun lalu] / Sales YTD / Growth YTD), scoped to whichever
// outlets the viewed POA's MR holds. Deliberately outlet-level only (not
// per-product like OutletSalesMonthly above) and covers a much wider window
// (full previous year through current YTD, not just a rolling 12 months) —
// see outletSalesValueMonthlySync.ts.
model OutletSalesValueMonthly {
  id         String   @id @default(uuid())
  // Not FK'd to Outlet — same as OutletSalesMonthly/OutletSalesHistory above,
  // this is raw source data and shouldn't reject rows for an outlet our
  // Outlet table hasn't synced yet.
  kodePI     String
  periode    String // YYYYMM
  valueSales Decimal  @db.Decimal(18, 2)
  syncedAt   DateTime

  @@unique([kodePI, periode])
  @@index([kodePI])
  @@index([periode])
}

// Monthly Rupiah sales TARGET per territory (GT) — from "internal/Target
// Hospital (in Value).xlsx", sheet "Rekap FFMedrep" (2026-07-31). One row per
// (namaGT, periode); the source sheet is wide (one column per month), this
// table is long like OutletSalesValueMonthly above. Distinct from
// ProductTargetAllocation — this is a territory-level Rupiah VALUE target
// ("target value"), not a per-product quantity ("target produk kontes").
//
// namaGT is the unit of assignment (source confirms 1 GT = 1 MR/SPV), so
// nipMR/namaMR is that GT's own person; nipASM/SM/NSM + names come directly
// from the same source row rather than being derived by walking
// User.nipAtasan from nipMR, so a row keeps its ASM/SM/NSM attribution even
// when the MR seat itself is vacant/shadow (source has literal "VACANT MR
// ..."/"... (SHADOW)" placeholder names for those — see
// importTargetHospitalValue.ts's name-matching notes). nip* fields are
// resolved by name match against User at import time and are nullable
// precisely for those vacant/shadow placeholders — nama* is always the raw
// source text regardless of whether resolution succeeded, so the row is
// still fully attributable/editable even unresolved.
model TargetHospitalValue {
  id        String   @id @default(uuid())
  namaGT    String
  periode   String // YYYYMM, e.g. "202608"
  target    Decimal  @db.Decimal(18, 2)
  nipMR     String?
  namaMR    String
  nipASM    String?
  namaASM   String
  nipSM     String?
  namaSM    String
  nipNSM    String?
  namaNSM   String
  syncedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namaGT, periode])
  @@index([periode])
  @@index([nipMR])
  @@index([nipASM])
  @@index([nipSM])
  @@index([nipNSM])
}

// Manual policy input ("Tambahan Target" in the source spreadsheet) — the
// per-month stretch increment an NSM/Admin sets for a product ahead of a
// quarter. The calculation engine derives everything else from sales data.
// Superseded 2026-07-21 by ProductTargetAllocation as the primary way targets
// get set (manual cascading NSM→SM→ASM→MR instead of this ratio/productivity
// algorithm) — kept for the existing "Simulasi Target Produk" reference view.
model ProductTargetInput {
  id          String   @id @default(uuid())
  kodeProduk  String
  quarter     String // e.g. "2026-Q3" — matches PoaForm.period format
  monthlyRamp Decimal  @db.Decimal(18, 2)
  setBy       String? // nip of the NSM/Admin who set it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kodeProduk, quarter])
}

// Manual per-product target, set by hand at EVERY org level, cascading
// NSM → SM (Area) → ASM → MR (2026-07-21, replaces the ratio+productivity
// algorithm above as the primary target-setting workflow — an admin sets an
// NSM's total first, then allocates it across that NSM's SMs, then each SM's
// total across its ASMs, then each ASM's total across its MRs). `nip` is
// whichever org-level person this row's qty belongs to; the level itself
// isn't stored here — it's implied by that NIP's own User.role. Enforcement
// that children sum to the parent's total is a UI-level nudge, not a DB
// constraint, since an admin may legitimately save a partial allocation
// mid-quarter and finish it later.
model ProductTargetAllocation {
  id         String   @id @default(uuid())
  kodeProduk String
  quarter    String // e.g. "2026-Q3"
  nip        String // NSM, SM, ASM, or MR nip — level implied by User.role
  qty        Decimal  @db.Decimal(18, 2)
  setBy      String? // nip of the admin/NSM who last saved this row
  updatedAt  DateTime @updatedAt

  @@unique([kodeProduk, quarter, nip])
  @@index([kodeProduk, quarter])
  @@index([nip])
}

// Criteria tag per product per outlet — from ProductPMDatabase Unpivot sheets.
// Drives "produk kontes per outlet" logic in the POA form and stats panel.
model OutletProductKriteria {
  id              String @id @default(uuid())
  kodePI          String
  kodeProduk      String
  paket           String // e.g. "PAKET PENCERNAAN"
  kategori        String // Low Hanging Fruit | Blue Ocean | Red Ocean
  kriteriaBaru    String // e.g. "Produk Sudah Terstandarisasi - Ada Sales"
  statusTransaksi Int // 0 or 1

  @@unique([kodePI, kodeProduk, paket])
  @@index([kodePI])
  @@index([kodeProduk])
}

// Junction: which MRs are assigned to which outlets per periode (from Struktur_Marketing_PI)
model MrOutletAssignment {
  id       String   @id @default(uuid())
  nipMR    String
  user     User     @relation(fields: [nipMR], references: [nip], onDelete: Cascade)
  kodePI   String
  outlet   Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  periode  Int // YYYYMM, e.g. 202607
  syncedAt DateTime

  @@unique([nipMR, kodePI, periode])
  @@index([nipMR])
  @@index([kodePI])
  @@index([periode])
}

// ─── KPI Monitoring (Monitoring KPI Perpanjangan) ────────────────────────────
// See docs/kpi-monitoring/ for the full spec. Source: Memo Internal
// SM/ETH-II/PI/08.2026 (28 Juli 2026, efektif 01 Agustus 2026) — 4-pillar
// weighted monthly scorecard for MR (incl. jabatan "SPV")/ASM/SM, feeding a
// contract-extension recommendation. Several formula details (visit standard
// numbers, absensi unit, PS/SP filter) are WORKING ASSUMPTIONS pending
// stakeholder confirmation — see docs/kpi-monitoring/01-business-rules.md §7.
// v1 access is ADMIN-only (2026-07-30 decision, same pattern as /monitoring).

// One row per personil × calendar month. Sales/customer figures are
// snapshotted here (not derived live) so historical months don't silently
// shift if underlying sync data is corrected later — same reasoning as
// PoaAuditLog storing snapshots rather than only live references.
model KpiMonthlyEntry {
  id     String @id @default(uuid())
  nip    String
  user   User   @relation(fields: [nip], references: [nip], onDelete: Cascade)
  period String // "YYYY-MM"

  // Business Result: Sales Achievement (50%) — auto-derived snapshot, same
  // source as Monitoring page's "Per MR" tab (PoaForm.target vs
  // OutletSalesValueMonthly).
  salesTargetRp       Decimal? @db.Decimal(18, 2)
  salesActualRp       Decimal? @db.Decimal(18, 2)
  salesAchievementPct Decimal? @db.Decimal(7, 2)

  // Activity & Coverage: Call Activity (25%) — manual input by atasan for v1,
  // no realized-visit data source exists anywhere else in this app (overlaps
  // docs/TODO.md #38/#25, both still unresolved).
  callActivityRealisasi  Int?
  callActivityStandar    Int? // working assumption: MR/SPV=10, ASM=5, SM=3 (§2b)
  callActivitySource     String    @default("MANUAL") // "MANUAL" | future sync source key
  callActivityInputByNip String?
  callActivityInputAt    DateTime?

  // Market Development: Customer Expansion (15%) — auto-derived from active
  // PSSP contracts (getActivePsspByOutlets), working assumption per §2c.
  customerAktifCount Int?

  // Attitude: Kepatuhan Absensi (10%) — manual input by atasan for v1, no
  // attendance data source exists anywhere in this app.
  absensiValue      Decimal?  @db.Decimal(6, 2) // working assumption: avg jam keterlambatan/bulan (§2d)
  absensiSource     String    @default("MANUAL")
  absensiInputByNip String?
  absensiInputAt    DateTime?

  // Cached band scores (0/40/55/70/85/100) + weighted total, recomputed
  // whenever an input above changes — avoids re-running band logic on every
  // listing render.
  salesScore    Int?
  activityScore Int?
  customerScore Int?
  absensiScore  Int?
  totalScore    Decimal? @db.Decimal(5, 2)

  computedAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([nip, period])
  @@index([period])
}

// Aggregation at contract-renewal time — window = the personil's current
// contract period (rolling, not a fixed calendar cycle; see
// docs/kpi-monitoring/01-business-rules.md §5), averaging every
// KpiMonthlyEntry inside [periodeMulai, periodeAkhir].
model KpiContractEvaluation {
  id   String @id @default(uuid())
  nip  String
  user User   @relation("KpiEvaluatee", fields: [nip], references: [nip], onDelete: Cascade)

  periodeMulai String // "YYYY-MM"
  periodeAkhir String // "YYYY-MM"

  avgSalesScore    Decimal @db.Decimal(5, 2)
  avgActivityScore Decimal @db.Decimal(5, 2)
  avgCustomerScore Decimal @db.Decimal(5, 2)
  avgAbsensiScore  Decimal @db.Decimal(5, 2)
  totalScore       Decimal @db.Decimal(5, 2)

  systemRecommendationMonths Int // band result: 12/9/6/0

  // Atasan's actual decision — may differ from the system recommendation
  // ("keputusan diusulkan atasan, tidak harus mengikuti rekomendasi asal ada
  // penjelasan jelas dan logis"). decisionReason is required at the
  // server-action layer whenever decisionMonths != systemRecommendationMonths.
  decisionMonths Int
  decisionReason String?

  // Wajib per memo: "Evaluasi Rencana Pengembangan Personil" + rasionalisasi ke direksi.
  developmentPlanNotes String

  evaluatedByNip String
  evaluatedBy    User     @relation("KpiEvaluator", fields: [evaluatedByNip], references: [nip])
  evaluatedAt    DateTime @default(now())

  @@index([nip])
  @@index([evaluatedByNip])
}

// ─── Maintenance Mode ──────────────────────────────────────────────────────────
// Site-wide lockout switch (2026-07-31) — when enabled, every (app) route
// shows only the maintenance screen for non-ADMIN roles (see (app)/layout.tsx);
// ADMIN keeps full access so they can turn it back off. Singleton row,
// always id=1 — upserted, never inserted a second time.
//
// viewOnly (2026-08-03): a softer sibling of `enabled` — non-ADMIN roles keep
// full read/browse access to every page, but every mutating server action is
// blocked (see assertWritable/isWriteBlocked in src/lib/maintenance.ts, called
// from every "use server" write path). Meant for DB migrations: freeze new
// writes without a full outage, so people can keep reading data mid-migration.
// `enabled` (full lockout) implies write-blocked too — isWriteBlocked() checks
// both flags, not just this one.
model MaintenanceMode {
  id           Int      @id @default(1)
  enabled      Boolean  @default(false)
  viewOnly     Boolean  @default(false)
  message      String?  @db.Text
  updatedByNip String?
  updatedAt    DateTime @updatedAt
}

// Singleton credential for /api/poa-doctors's HTTP Basic Auth path (2026-08-19)
// — lets an external app call that endpoint without a session cookie. DB-backed
// instead of an env var so an ADMIN can rotate it from the Admin page without a
// redeploy (see setPoaDoctorsApiCredentialAction, admin/page.tsx). Password
// stored as a scrypt hash+salt (src/lib/secretHash.ts), never plaintext — same
// singleton-row pattern as MaintenanceMode above.
model PoaDoctorsApiCredential {
  id           Int      @id @default(1)
  username     String
  passwordHash String
  passwordSalt String
  updatedByNip String?
  updatedAt    DateTime @updatedAt
}

// Cross-replica mutex for in-process schedulers (see
// salesHistoryMonthlyScheduler.ts) — multiple pods each run their own
// setTimeout/setInterval, so without this every replica would re-run the
// same sync at ~the same instant. Claimed via a single atomic
// `INSERT ... ON CONFLICT DO UPDATE ... WHERE lockedAt < now() - staleAfter`
// (see acquireSyncLock in syncLock.ts) — self-heals if a replica dies
// mid-run instead of holding the lock forever, unlike a session-level
// pg_advisory_lock (which doesn't survive Prisma's pooled connections
// reliably) or a long-held transaction.
model SyncLock {
  key      String   @id
  lockedAt DateTime
}

// ─── POA Standarisasi ────────────────────────────────────────────────────────
// Sub-form BARU, terpisah dari PoaForm/PoaLineItem — lihat docs/poa-standarisasi/.
// POA Estimasi (existing, di atas) di-scope Dokter × Produk; POA Standarisasi
// di-scope Produk × Outlet (satu PoaStandarisasi = satu outlet, berisi banyak
// PoaStandarisasiProduk — dokter jadi sub-entity pendukung per produk, bukan
// sumbu baris utama). Wizard 5-phase: Planning Standarisasi → Approval Atasan
// → Approval User/Dokter → Menunggu Meeting KFT → Finalisasi (2026-08-19 —
// Menunggu Meeting KFT dipisah jadi step sendiri, SETELAH tracking TTD dokter,
// untuk upload dokumen standarisasi (NIE/CPOB/KFA/SP Non Sales, read-only di
// sini — diupload dari tempat lain) + Form Approval Standarisasi + jadwal
// meeting; 2026-08-20 urutan dikoreksi — sebelumnya kebalik ditaruh sebelum
// Approval User/Dokter. Enum value order below is unrelated to app phase
// order — the app compares by name, not ordinal position, so it's left as-is.

enum PoaStandarisasiPhase {
  PLANNING
  APPROVAL_ATASAN
  MENUNGGU_MEETING_KFT
  APPROVAL_USER_DOKTER
  FINALISASI
}

enum TipeStandarisasi {
  PERIODIC
  SISIPAN
  PERMANEN
}

// Label status of the pengajuan itself — is this a brand-new standarisasi
// or a renewal of one that already existed at this outlet? (docs/TODO.md
// #12, 2026-08-26). Manual pilihan MR, not derived — orthogonal to
// TipeStandarisasi (Periodic/Sisipan/Permanen is about the SCHEDULE, this is
// about the STATUS).
enum StatusPengajuanStandarisasi {
  BARU
  PERPANJANGAN
}

enum StatusApprovalAtasan {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum DokumenStandarisasiJenis {
  NIE
  CPOB
  KFA
  SP_NON_SALES
}

// Fixed set, not master data — checkbox multi-select in Finalisasi (2026-08-19,
// replaces the old single-select Distributor master-data dropdown, which had
// no rows and no other callers).
enum DistributorPilihan {
  AMS
  PPG
  MPI
}

// Header pengajuan — satu row = satu Outlet, berisi N produk.
model PoaStandarisasi {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [nip])

  kodePI String
  outlet Outlet @relation(fields: [kodePI], references: [kodePI])

  // KPDM — bisa LEBIH DARI SATU per outlet (2026-08-20: was single
  // kpdmId/kpdmNamaSnapshot/jabatanNamaSnapshot/kpdmEntertainEstimasi/
  // kpdmEntertainFinal scalar fields, now PoaStandarisasiKpdm child rows,
  // same "list of customer + own entertain" shape as Dokter Klinis).
  kpdmList PoaStandarisasiKpdm[]

  tipeStandarisasi TipeStandarisasi
  // Baru vs Perpanjangan — dipilih manual oleh MR di Planning (docs/TODO.md
  // #12), bukan diturunkan otomatis dari histori. Default BARU biar baris
  // existing (kalau ada) tidak perlu backfill manual.
  statusPengajuan  StatusPengajuanStandarisasi @default(BARU)
  // Wajib utk PERIODIC/SISIPAN, null utk PERMANEN — kondisional, divalidasi
  // di server action (bukan constraint DB).
  periodeBulan     Int?

  jumlahBedRs             Int? // snapshot dari Outlet.jumlahBed saat dipilih, tapi editable & independen
  estimasiTimelineSelesai DateTime?

  currentPhase PoaStandarisasiPhase @default(PLANNING)

  statusApprovalAsm  StatusApprovalAtasan @default(MENUNGGU)
  statusApprovalSm   StatusApprovalAtasan @default(MENUNGGU)
  statusApprovalNsm  StatusApprovalAtasan @default(MENUNGGU)
  tanggalApprovalAsm DateTime?
  tanggalApprovalSm  DateTime?
  tanggalApprovalNsm DateTime?

  jadwalMeetingKft DateTime?

  distributors DistributorPilihan[] @default([])

  // Satu file untuk seluruh pengajuan (asumsi kerja, lihat
  // 01-business-rules.md §7 Q6 — belum dikonfirmasi tim bisnis).
  suratApprovalStandarisasiKftPath        String?
  suratApprovalStandarisasiKftDriveFileId String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  produk PoaStandarisasiProduk[]

  @@index([ownerId])
  @@index([kodePI])
  @@index([currentPhase])
}

model PoaStandarisasiProduk {
  id String @id @default(uuid())

  pengajuanId String
  pengajuan   PoaStandarisasi @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  kodeProduk String
  product    Product @relation(fields: [kodeProduk], references: [kodeProduk])

  // TIDAK ada FK ke SurveyRekomendasi — "Golongan yang Dipakai Saat Ini"
  // di-resolve LIVE per dokter via getSurveyRekomendasiInfo() di server
  // action (sama pola dengan PoaLineItem, yang juga tidak menyimpan FK ini).

  // Jumlah Pasien/Resep per Pasien/Entertain TIDAK di sini — dipindah ke
  // level dokter (PoaStandarisasiDokterApproval, sama pola dengan Finalisasi's
  // PoaStandarisasiDokterUser) karena estimasinya memang berbeda per dokter,
  // bukan satu angka gabungan per produk.
  estimasiDiskonPct      Decimal? @db.Decimal(10, 4)
  estimasiBiayaListingRp Decimal? @db.Decimal(18, 2)

  // ── Finalisasi Biaya ──────────────────────────────────────────────────
  finalDiscountPct     Decimal? @db.Decimal(10, 4)
  diskonDistributorPct Decimal? @db.Decimal(10, 4)
  finalBiayaListingRp  Decimal? @db.Decimal(18, 2)
  // finalEntertain TIDAK ada di sini — computed dari SUM PoaStandarisasiDokterUser.entertainRp

  formApprovalFilePath    String?
  formApprovalDriveFileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dokterApproval PoaStandarisasiDokterApproval[]
  dokterUser     PoaStandarisasiDokterUser[]
  dokumen        PoaStandarisasiDokumen[]

  @@unique([pengajuanId, kodeProduk])
  @@index([pengajuanId])
}

// KPDM — bisa lebih dari satu orang per pengajuan (2026-08-20). Sama pola
// dengan PoaStandarisasiDokterApproval: customerId Nexus-backed, nama/jabatan
// disnapshot di waktu pengajuan dibuat, entertain PER ORANG (bukan shared).
model PoaStandarisasiKpdm {
  id String @id @default(uuid())

  pengajuanId String
  pengajuan   PoaStandarisasi @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  namaSnapshot    String
  jabatanSnapshot String?

  entertainEstimasi Decimal? @db.Decimal(18, 2)
  entertainFinal    Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pengajuanId, customerId])
  @@index([pengajuanId])
}

// Dokter Klinis (Planning) — checklist "sudah TTD" per produk, BUKAN
// approval in-app oleh dokter (lihat 01-business-rules.md §1/§6).
model PoaStandarisasiDokterApproval {
  id String @id @default(uuid())

  produkId String
  produk   PoaStandarisasiProduk @relation(fields: [produkId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  wajib    Boolean @default(true)
  sudahTtd Boolean @default(false)

  // ── Estimasi Standarisasi (Planning) — per dokter, bukan per produk ─────
  jumlahPasien     Int?
  resepPerPasienSt Decimal? @db.Decimal(10, 2)

  // Nilai PER BULAN (bukan total periode, lihat 01-business-rules.md §3/§7
  // Q4) — computed di server dari jumlahPasien × resepPerPasienSt ×
  // hargaST(product), tidak trust dari client.
  estimasiQtyPerBulan     Decimal? @db.Decimal(18, 2)
  estimasiNilaiRpPerBulan Decimal? @db.Decimal(18, 2)

  entertainRp Decimal? @db.Decimal(18, 2) // manual, tidak ada formula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produkId, customerId])
  @@index([produkId])
}

// "Dokter yang Akan Menjadi User" (Finalisasi) — entitas TERPISAH dari
// PoaStandarisasiDokterApproval: field & siklus hidupnya beda (Jumlah
// Pasien/Resep per Pasien/Entertain baru diisi di Finalisasi, MR boleh
// ganti dokternya tanpa mengubah histori approval TTD Phase 3).
model PoaStandarisasiDokterUser {
  id String @id @default(uuid())

  produkId String
  produk   PoaStandarisasiProduk @relation(fields: [produkId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  jumlahPasien     Int?
  resepPerPasienSt Decimal? @db.Decimal(10, 2)

  // Nilai PER BULAN, formula sama dengan level produk — computed di server.
  estimasiQtyPerBulan     Decimal? @db.Decimal(18, 2)
  estimasiSalesRpPerBulan Decimal? @db.Decimal(18, 2)

  entertainRp Decimal? @db.Decimal(18, 2) // manual, tidak ada formula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produkId, customerId])
  @@index([produkId])
}

// NIE/CPOB/KFA/SP Non Sales — download-only, per produk.
model PoaStandarisasiDokumen {
  id String @id @default(uuid())

  produkId String
  produk   PoaStandarisasiProduk @relation(fields: [produkId], references: [id], onDelete: Cascade)

  jenis       DokumenStandarisasiJenis
  namaFile    String
  driveFileId String

  createdAt DateTime @default(now())

  @@unique([produkId, jenis])
  @@index([produkId])
}

// ─── Sales Counter (Apotek/Retail) Models ───────────────────────────────────

// 1. Dokumen Utama/Header (Per-Outlet Per-Kuartal)
model PoaScForm {
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Kolom Periode & Waktu
  period          String               // e.g. "2026-Q2" (Untuk grouping & filter)
  periodeAwal     String               // e.g. "202604" (YYYYMM untuk lookup diskon)
  lamaPeriode     Int                  // e.g. 3 (Durasi bulan untuk kalkulasi biaya)
  
  status          PoaStatus            @default(DRAFT)
  version         Int                  @default(1)

  kodePI          String               // e.g. "F1000271"
  namaOutlet      String?              // e.g. "Apotek Kimia Farma"
  persenResepDokter   Int              @default(0)

  ownerId         String               // NIP MR pembuat
  owner           User                 @relation("PoaScOwner", fields: [ownerId], references: [nip])

  currentHolderId String?              // NIP Atasan penanggung jawab approval saat ini
  currentHolder   User?                @relation("PoaScCurrentHolder", fields: [currentHolderId], references: [nip])

  products        PoaScProductItem[]   // Daftar Produk
  persons         PoaScPersonItem[]    // Daftar Staff Canvasser
  entertainItems  PoaScEntertainItem[] // Biaya Entertain per-outlet
  auditLogs       PoaScAuditLog[]      // Log Aktivitas

  @@unique([kodePI, periodeAwal, ownerId]) // Unik per outlet, per bulan mulai, per MR
  @@index([ownerId])
  @@index([currentHolderId])
  @@index([status])
}

// 2. Detail Produk di Outlet Tersebut (Dihitung per-orang)
model PoaScProductItem {
  id                  String     @id @default(uuid())
  poaScId             String
  poaSc               PoaScForm  @relation(fields: [poaScId], references: [id], onDelete: Cascade)

  kodeProduk          String
  namaProduk          String
  produkKompetitor    String?

  // Parameter Rencana Penjualan per Produk
  qtyPerBulan         Int        @default(0) // Qty produk Satuan Terkecil per bulan

  // Persentase Finansial & Insentif
  persenMatriksSc     Decimal    @db.Decimal(5, 2)  // Nilai insentif SC dari HNA
  persenDiskon        Decimal    @db.Decimal(5, 2)
  persenCashback      Decimal    @db.Decimal(5, 2)

  // Estimasi Biaya Rencana untuk 1 orang canvasser
  rencanaTotalBiaya   Decimal    @db.Decimal(18, 2)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([poaScId])
  @@unique([poaScId, kodeProduk]) // Satu produk hanya boleh diinput 1 kali per outlet
}

// 3. Daftar Staff Canvasser / Sales Counter Person yang ditugaskan di Outlet
model PoaScPersonItem {
  id              String     @id @default(uuid())
  poaScId         String
  poaSc               PoaScForm  @relation(fields: [poaScId], references: [id], onDelete: Cascade)

  // Data Staff Canvasser
  nik_ktp         String     // NIK Staff SC
  personName      String     // Nama Staff SC
  positionName    String     // Jabatan (Apoteker, SPV, dll.)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([poaScId])
  @@unique([poaScId, nik_ktp]) // Satu staff hanya boleh terdaftar 1 kali per outlet
}

// 4. Biaya Rencana Entertain Bulanan (Per-Outlet Per-Bulan)
model PoaScEntertainItem {
  id              String     @id @default(uuid())
  poaScId         String
  poaSc           PoaScForm  @relation(fields: [poaScId], references: [id], onDelete: Cascade)

  periodeMonth    String     // Format YYYYMM (e.g. "202604")
  biayaEntertain  Decimal    @db.Decimal(18, 2)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([poaScId, periodeMonth]) // Maksimal 1 entri entertain per bulan per outlet
}

// 5. Log Riwayat Audit
model PoaScAuditLog {
  id              String       @id @default(uuid())
  poaScId         String
  poaSc           PoaScForm    @relation(fields: [poaScId], references: [id], onDelete: Cascade)
  actorId         String
  actor           User         @relation(fields: [actorId], references: [nip])
  action          AuditAction
  fromStatus      PoaStatus?
  toStatus        PoaStatus?
  snapshot        Json         @default("{}") // Untuk notes revisi dari atasan
  createdAt       DateTime     @default(now())

  @@index([poaScId])
}

// Model penyimpan daftar Kode PI untuk Blast-In
model OutletBlastIn {
  kodePI    String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reference table for DPL/DPF discounts by product code and period
model DiskonDplDpf {
  id        String   @id @default(uuid())
  proCode   String
  diskon    Decimal  @db.Decimal(10, 4)
  periode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proCode])
  @@index([periode])
}


