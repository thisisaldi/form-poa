  targetSales Decimal? @db.Decimal(18, 2)

  kdProduk String?
  nmProduk String?
  nsm      String?

  // Per-period detail as JSONB: { "202604": 1234.56, ... }
  bmByPeriod         Json @default("{}")
  pctListingByPeriod Json @default("{}")

  snapshotDate DateTime? // date of source Excel file
  importedAt   DateTime  @default(now())

  @@unique([noreq, kdProduk])
  @@index([kdCust])
  @@index([kdOutlet])
  @@index([prdAwal, prdAkhir])
