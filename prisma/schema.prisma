// ─── DPL (Diskon Penjualan Langsung) Contract Data ────────────────────────────
// PRIMARY source for "% Diskon (DPL/DPF)" (see resolveDiskonPct in
// LineItemEditor.tsx) — one row per (NOMOR contract × PRODUK). Imported via
// scripts/importDpl.ts from "internal/DPL <bulan tahun>.xlsx" snapshots
// (sheet "DPL", e.g. "internal/DPL MEI 2026.xlsx"). newOnPi is the
// effective/active on-invoice discount % used to auto-fill
// PoaLineItem.avgDiskon for contracts whose period is running. DiskonHistory
// below is only ever consulted as a FALLBACK when no row here covers the
// outlet+product+period.

model DiskonKontrak {
  id String @id @default(uuid())

  nomor      String // NOMOR — contract number
  nmAreaPi   String?
  areaPi     String?
  kodePIRaw  String // raw KODEPI from source sheet (numeric suffix only)
  kodePI     String // areaPi + kodePIRaw — matches Outlet.kodePI
  namaOutlet String?
  bumn       String?
  divisi     String?

  prdAwal  String // YYYYMM
  prdAkhir String // YYYYMM

  kodeProduk String
  namaProduk String?

  onPi    Decimal? @db.Decimal(10, 4)
  offPi   Decimal? @db.Decimal(10, 4)
  onDist  Decimal? @db.Decimal(10, 4)
  offDist Decimal? @db.Decimal(10, 4)
  qtyBon  Decimal? @db.Decimal(10, 2)
  qtyBuy  Decimal? @db.Decimal(10, 2)

  newOnPi Decimal? @db.Decimal(10, 4) // effective on-invoice discount %, used for avgDiskon

  snapshotDate DateTime? // date of source Excel file
  importedAt   DateTime  @default(now())

  @@unique([nomor, kodeProduk])
  @@index([kodePI])
  @@index([kodeProduk])
  @@index([prdAwal, prdAkhir])
