generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  MR
  ASM
  SM
  NSM
  GM
  ADMIN
  SFE
  // Same read-only company-wide oversight as GM (every POA + full Summary,
  // no edit/approve/create rights) — kept as a distinct role rather than
  // reusing GM so it isn't conflated with the real General Manager title
  // (2026-07-29 request).
  VIEWER
}

enum PoaStatus {
  DRAFT
  SUBMITTED_TO_ASM
  APPROVED_BY_ASM
  SUBMITTED_TO_SM
  APPROVED_BY_SM
  SUBMITTED_TO_NSM
  APPROVED_BY_NSM
  REVISI
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REVISE
  REJECT
  CANCEL
  REQUEST_EDIT
  GRANT_EDIT
  DECLINE_EDIT
}

// docs/poa-rejection-categories/ (2026-08-13) — tag on a REJECT audit event
// classifying WHY the doctor was rejected. Only ever set on rows with
// action = REJECT (main "Tolak" form, per-doctor — see 01-business-rules.md
// §2/OQ-1 RESOLVED: cuma form Tolak utama, bukan Tolak-edit/Batalkan-Approval),
// null for every other action. See PoaAuditLog.rejectCategory below.
enum PoaRejectCategory {
  PRODUK
  OUTLET
  USER
  PERIODE
  KALKULASI_PSSP
  ALASAN_LAIN
}

enum StatusStandarisasi {
  SUDAH_STANDARISASI
  PROSES_PENGAJUAN
  BELUM_STANDARISASI
  TIDAK_TAHU
}

enum JenisPssp {
  PSSP
  PSSP_RETENSI
  PSSP_PEREMAJAAN
  PSSP_PERPANJANGAN
}

// Which party the "% PSSP" figure on a line item belongs to — purely a
// display-label switch (2026-07-24 request): selecting KPDM renames "%
// PSSP User" to "% PSSP KPDM" in the form/exports, the field and formula
// underneath are unchanged (persenPsspDokter stays the one source of truth
// — see LineItemEditor.tsx history around persenPsspKpdm's removal).
enum PihakPssp {
  USER
  KPDM
}

// Simple PS/SP classification at doctor level — business meaning not yet
// pinned down at request time (2026-07-24); kept as a plain 2-value choice
// rather than folded into JenisPssp.
enum PsSp {
  PS
  SP
}

// Doctor-level "Jenis PSSP" choice shown next to PS/SP (2026-07-28 request) —
// what FORM the PSSP arrangement takes, not to be confused with JenisPssp
// above (PSSP/Retensi/Peremajaan/Perpanjangan, currently hidden in the UI).
enum BentukPssp {
  CASH
  BARANG
  JASA
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  nip       String    @id
  name      String
  role      Role
  // Display-only override for what's SHOWN as this person's title (e.g. "SPV")
  // when their actual `role`/permissions are a lower level (SPV collapses to
  // MR everywhere in this app — same approval rights, same outlet-holding
  // rules — see scripts/importStrukturHospital.ts). Null means "just show role".
  jabatan   String?
  email     String?
  isActive  Boolean   @default(true)
  isDummy   Boolean   @default(false) // workshop/demo account — bypasses outlet-assignment restrictions
  syncedAt  DateTime?
  // Discovered (not synced from anywhere — no source tells us this) AbsPTID
  // for the SIPP attendance API — one NIP can only ever be at one PT. Cached
  // by kpiAbsensiSync.ts after probing ABS_PT_ID_CANDIDATES so repeat syncs
  // don't re-probe every candidate for every person. Null = not discovered
  // yet (new hire, or no attendance data in any candidate PT).
  sippAbsPtId Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   String?

  // Territory assignment (derived from org structure CSV)
  // MR → GT, SPV (MR) → Sub, ASM → Area, SM → Reg
  kodeWilayah String?
  namaWilayah String?

  // Self-relation for org hierarchy
  nipAtasan    String?
  namaAtasan   String?
  reportsTo    User?   @relation("OrgHierarchy", fields: [nipAtasan], references: [nip])
  subordinates User[]  @relation("OrgHierarchy")

  // POA ownership
  ownedPoas           PoaForm[]           @relation("PoaOwner")
  heldPoas            PoaForm[]           @relation("PoaCurrentHolder")
  heldDoctorApprovals PoaDoctorApproval[] @relation("PoaDoctorApprovalHolder")

  // Audit activity
  auditLogs PoaAuditLog[]

  // Doctor registration submissions
  pengajuanCustomer CustomerPengajuan[] @relation("CustomerPengajuanSubmitter")

  // Outlet assignments (synced from MSSQL)
  outletAssignments MrOutletAssignment[]

  // KPI Monitoring (see docs/kpi-monitoring/)
  kpiMonthlyEntries      KpiMonthlyEntry[]
  kpiContractEvaluations KpiContractEvaluation[] @relation("KpiEvaluatee")
  kpiEvaluationsGiven    KpiContractEvaluation[] @relation("KpiEvaluator")

  // Survey upload audit trail (see docs/survey-pasien-features/)
  surveyUploadLogs SurveyUploadLog[]

  // POA Standarisasi (see docs/poa-standarisasi/) — pembuat pengajuan
  poaStandarisasiOwned PoaStandarisasi[]

  // ─── Tambahan Relasi Balik untuk Sales Counter ───
  poaScOwned           PoaScForm[]          @relation("PoaScOwner")
  poaScHeld            PoaScForm[]          @relation("PoaScCurrentHolder")
  poaScAuditLogs       PoaScAuditLog[]

  @@index([nipAtasan])
  @@index([role])
}

model PoaForm {
  id        String    @id @default(uuid())
  // docs/exodus-poa-usage/ (2026-08-26) — global, never-reset sequence for the
  // human-readable "POA0001" id Exodus needs (id stays the internal uuid PK,
  // never exposed to them as the primary identifier). Backfilled for existing
  // rows in createdAt order by the migration that added this column.
  seq       Int       @unique @default(autoincrement())
  period    String // e.g. "2026-07" — flexible, not locked to monthly
  status    PoaStatus @default(DRAFT)
  version   Int       @default(1) // bumped every time it re-enters REVISI — "Version X" label
  target    Decimal?  @db.Decimal(18, 2) // sales target in Rupiah set by atasan
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownerId String
  owner   User   @relation("PoaOwner", fields: [ownerId], references: [nip])

  // Null in DRAFT (owner holds it implicitly) or once fully approved
  currentHolderId String?
  currentHolder   User?   @relation("PoaCurrentHolder", fields: [currentHolderId], references: [nip])

  auditLogs       PoaAuditLog[]
  items           PoaLineItem[]
  doctorApprovals PoaDoctorApproval[]

  @@index([ownerId])
  @@index([currentHolderId])
  @@index([status])
}

// Approval unit per-dokter within a PoaForm — see docs/poa-per-doctor-approval/
// (2026-08-13 decision: approve/reject moved from whole-draft to per-doctor
// granularity, so ASM/SM/NSM can approve Doctor A while rejecting Doctor B in
// the SAME draft). "Dokter" = 1 (kodePI, namaCust) pair, same doctorKey concept
// as DraftChecklist.tsx's grouping of PoaLineItem rows — all PoaLineItem rows
// for one doctor (1 per product) move as a single approval unit; there is no
// per-product approval. Denormalized identity (kodePI/namaCust) rather than an
// FK to one specific PoaLineItem because a doctor spans many line items.
// Created lazily: a row only exists once that doctor has been submitted at
// least once — a doctor still sitting in DRAFT/REVISI within an otherwise
// in-flight draft has no row yet. PoaForm.status/currentHolderId remain a
// live-derived rollup over these rows (see resolvePoaRollup in poaWorkflow.ts)
// for code that hasn't been generalized to per-doctor yet (exports, dashboards
// — docs/poa-per-doctor-approval/03-ui-and-access.md Non-goals v1).
model PoaDoctorApproval {
  id       String  @id @default(uuid())
  poaId    String
  poa      PoaForm @relation(fields: [poaId], references: [id], onDelete: Cascade)
  kodePI   String
  namaCust String

  status  PoaStatus @default(SUBMITTED_TO_ASM)
  version Int       @default(1) // bumped every time THIS doctor re-enters REVISI

  // Null once fully approved, or while sitting with the owner (DRAFT/REVISI,
  // not yet (re)submitted).
  currentHolderId String?
  currentHolder   User?   @relation("PoaDoctorApprovalHolder", fields: [currentHolderId], references: [nip])

  // docs/exodus-poa-usage/ (2026-08-26) — set once (never reverted, even if
  // rejected on the Exodus side) by an external "mark as used" call from
  // Exodus, surfaced back to them via GET /api/poa-doctors so they don't
  // double-submit the same doctor. usedInExodusAt is the write timestamp.
  usedInExodus   Boolean   @default(false)
  usedInExodusAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs PoaAuditLog[]

  @@unique([poaId, kodePI, namaCust])
  @@index([poaId])
  @@index([currentHolderId])
  @@index([status])
}

model Customer {
  id           String    @id @default(uuid())
  kodeCustomer String?   @unique
  namaCustomer String
  spesialisasi String
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  outlets                        CustomerOutlet[]
  psspHospinetSnapshots          PsspHospinetSnapshot[]
  poaStandarisasiDokterApprovals PoaStandarisasiDokterApproval[]
  poaStandarisasiDokterUsers     PoaStandarisasiDokterUser[]
  poaStandarisasiAsKpdm          PoaStandarisasiKpdm[]

  @@index([spesialisasi])
  @@index([namaCustomer])
}

model CustomerOutlet {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kodePI     String
  outlet     Outlet    @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  isFokus    Boolean   @default(false)
  syncedAt   DateTime?

  @@unique([customerId, kodePI])
  @@index([kodePI])
  @@index([customerId])
  @@index([kodePI, isFokus])
}

// Customer-level PSSP snapshot for divisions not covered by PsspKontrak's
// contract-level import (e.g. Hospinet — see docs/TODO.md #40). Source
// files here have no contract number, no per-product breakdown, and no
// monthly detail — just one current lump value per customer×outlet — so
// this deliberately does NOT reuse PsspKontrak's shape (same reasoning as
// DiskonHistory vs DiskonKontrak: coarser fallback data gets its own model
// rather than fabricating fields PsspKontrak requires but the source lacks).
model PsspHospinetSnapshot {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kodePI         String
  outlet         Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  // Hospinet's own internal customer numbering (source "Kode Customer" column,
  // "0" means none) — a DIFFERENT namespace than Customer.kodeCustomer (the
  // main CDB code, alphanumeric like "F1045097"). Never write this into
  // Customer.kodeCustomer — customer identity here is still resolved by name.
  kodeCustomer   String?
  statusCustomer String // "active-repeat" | "inactive-new"
  psspBerjalan   Boolean // true when source "Terakhir PSSP" == "Berjalan"
  periodeAwal    String? // YYYYMM, source "-" (no current/last PSSP period) → null
  periodeAkhir   String? // YYYYMM, same null convention
  valuePssp      Decimal  @db.Decimal(18, 2)
  pelunasan      Decimal  @db.Decimal(18, 2)
  rr             Decimal? @db.Decimal(10, 4) // pelunasan / valuePssp, as given by source
  syncedAt       DateTime

  @@unique([customerId, kodePI])
  @@index([kodePI])
}

// Per-doctor×outlet×recommended-product survey row, from "17062026 Data
// Rekomendasi Final.xlsx" — for each (doctor, outlet) the survey matched a
// Pharos product by zat aktif/bentuk sediaan ("Kode Produk"/"Produk
// Rekomendasi"), and separately recorded what brand-level products that
// doctor has actually prescribed within that same category ("History
// Produk", e.g. "AZOMAX CAPLET FC 500MG 10 BLIS (88.8%); AZITHROMYCIN
// INFUSION VLS 500MG (7.9%)") — a mix of our own and competitor brands.
// Used to auto-suggest "Produk Kompetitor" on the POA form: when an MR
// picks a product in the dropdown that matches this row's kodeProduk, the
// non-Pharos entries in historyProduk are surfaced (see getKompetitorHistory
// in customer.ts). kodeCustomer/kodePI are matched by string against
// Customer.kodeCustomer/Outlet.kodePI at query time — not FK'd, since a
// doctor here doesn't need to already exist as a full Customer row.
model SurveyRekomendasi {
  id                    String   @id @default(uuid())
  kodePI                String
  outlet                Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  kodeCustomer          String // "Kode Dokter" — same namespace as Customer.kodeCustomer, not FK'd
  namaCustomer          String
  kodeProduk            String // Pharos's own recommended product for this doctor+category
  namaProdukRekomendasi String
  zatAktif              String?
  dosageForm            String?
  kodeSpesialis         String?
  spesialis             String?
  potensiBulan          Decimal? @db.Decimal(10, 2)
  historyProduk         String // raw "PRODUCT NAME (XX.X%); PRODUCT NAME (YY.Y%)" string
  statusSales           String?
  statusPssp            String?
  metodePemilihan       String?
  syncedAt              DateTime

  @@unique([kodePI, kodeCustomer, kodeProduk])
  @@index([kodePI, kodeCustomer])
}

// Audit trail for "Input Data Survey" (docs/survey-pasien-features/, item #10
// dari daftar 13 task 2026-08-10) — MR upload file Excel, diteruskan ke
// shared Google Drive via service account. App tidak parse isi file, cuma
// jadi perantara upload + catat siapa-upload-apa-kapan. Append-only: satu
// row = satu upload yang BERHASIL tersimpan di Drive (upload gagal tidak
// menghasilkan row, lihat 01-business-rules.md §4).
model SurveyUploadLog {
  id          String   @id @default(uuid())
  uploaderNip String
  uploader    User     @relation(fields: [uploaderNip], references: [nip])
  kodePI      String
  outlet      Outlet   @relation(fields: [kodePI], references: [kodePI])
  periode     String // format YYYYMM
  namaFile    String // nama final dipakai di Drive — format §3a: "[YYYYMMDDHHMM] - Data Survey [Nama RS] Periode [Periode] oleh [Pengaju]"
  driveFileId String // Google Drive file ID dari response files.create
  // Biaya Data / Sumber (docs/TODO.md #18, 2026-08-13 — extends v1).
  // biayaData nullable (Rupiah) — belum wajib sampai dikonfirmasi.
  // sumber plain String (bukan Postgres enum) SENGAJA — whitelist-nya di
  // src/lib/surveySumber.ts (dikonfirmasi pengguna 2026-08-13), gampang
  // diganti tanpa migration baru kalau daftarnya berubah lagi nanti.
  biayaData   Decimal? @db.Decimal(18, 2)
  sumber      String?
  uploadedAt  DateTime @default(now())

  @@index([uploaderNip])
  @@index([kodePI])
  @@index([periode])
}

model PoaLineItem {
  id    String  @id @default(uuid())
  poaId String
  poa   PoaForm @relation(fields: [poaId], references: [id], onDelete: Cascade)

  // ── Customer group (auto-filled from Customer lookup) ────────────────────
  kodeRequest      String? // legacy PSSP contract code — nullable
  kodeCust         String? // Customer.kodeCustomer
  namaCust         String
  role             String // e.g. "Dokter Spesialis"
  spesialisasi     String
  // True when namaCust came from a Customer the MR registered manually via
  // "Daftar User Baru" (Customer.syncedAt == null at line-item creation time),
  // not from the synced CDB. Flagged in the Excel exports so reviewers know
  // this doctor isn't yet in the official customer database.
  isManualCustomer Boolean @default(false)
  historisPSSP     String?
  kodePI           String?
  namaOutlet       String

  // ── Product group (auto-filled from kodeProduk lookup) ───────────────────
  kodeProduk          String
  namaProduk          String
  kategoriProdukFokus String
  itemKode            String
  satuanTerkecil      String

  // ── MR manual input ───────────────────────────────────────────────────────
  labelCustomer      String?
  produkKompetitor   String?
  kriteriaProduk     String?
  statusStandarisasi StatusStandarisasi?
  jenisPssp          JenisPssp?
  // Per-product — see PihakPssp doc comment above.
  pihakPssp          PihakPssp           @default(USER)
  // Doctor-level (same value duplicated across all of one doctor's product
  // rows, same pattern as hariKerjaBulan/rencanaVisitMinggu below) — see
  // PsSp doc comment above.
  jenisPsSp          PsSp?
  // Doctor-level, same duplication pattern as jenisPsSp above — see
  // BentukPssp doc comment.
  bentukPssp         BentukPssp?

  // tentative fields (C20-C23) — nullable
  hariKerjaBulan   Int?
  jumlahPasienHari Int?
  jumlahResepHari  Int?
  qtyProdukResep   Int?

  lamaPeriode Int // 1, 3, 6, or 12
  periodeAwal String // YYYYMM
  // periodeAkhir is NOT stored — computed as periodeAwal + (lamaPeriode-1) months

  rencanaTotalBiaya  Decimal @db.Decimal(18, 2)
  rencanaVisitMinggu Int
  // Doctor-level, same duplication pattern as rencanaVisitMinggu above — MR's
  // own survey count of daily patients, shown as a "Referensi PM" hint next
  // to the per-product jumlahResepHari ("Pasien Baru / Hari") input in the
  // form (see ProdukEntryRow in LineItemEditor.tsx).
  surveyPasienHarian Int     @default(0)

  // ── Master data (auto from sync) ─────────────────────────────────────────
  nilaiR           Decimal? @db.Decimal(18, 2)
  historySales3Bln Decimal? @db.Decimal(18, 2)
  avgDiskon        Decimal? @db.Decimal(18, 4)

  // ── MR input per produk ───────────────────────────────────────────────────
  rasioEstimasiGrowth Decimal? @db.Decimal(18, 4) // multiplier growth (e.g. 1.0 / 1.2)
  persenPsspDokter    Decimal? @db.Decimal(18, 4)
  persenPsspKpdm      Decimal? @db.Decimal(18, 4)
  persenDiskon        Decimal? @db.Decimal(18, 4)
  persenDp            Decimal? @db.Decimal(18, 4)
  persenListingFee    Decimal? @db.Decimal(18, 4)
  persenEntertain     Decimal? @db.Decimal(18, 4)

  // ── Formula placeholder columns (all nullable, computed externally) ───────
  hargaSatuanTerkecil          Decimal? @db.Decimal(18, 2)
  estimasiPSSPBulan            Decimal? @db.Decimal(18, 2)
  totalEstimasiPSSPBulan       Decimal? @db.Decimal(18, 2)
  pengaliNilaiR                Decimal? @db.Decimal(18, 4)
  rekomendasiBiayaBulan        Decimal? @db.Decimal(18, 2)
  totalRekomendasiBiayaBulan   Decimal? @db.Decimal(18, 2)
  estimasiPSSPPeriode          Decimal? @db.Decimal(18, 2)
  totalEstimasiPSSPPeriode     Decimal? @db.Decimal(18, 2)
  rekomendasiBiayaPeriode      Decimal? @db.Decimal(18, 2)
  totalRekomendasiBiayaPeriode Decimal? @db.Decimal(18, 2)
  rasioRekomenEstimasi         Decimal? @db.Decimal(18, 4)
  rasioRencanaBiayaEstimasi    Decimal? @db.Decimal(18, 4)
  totalPersenBudget            Decimal? @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poaId])
  @@index([kodeRequest])
}

model PoaAuditLog {
  id             String             @id @default(uuid())
  action         AuditAction
  fromStatus     PoaStatus?
  toStatus       PoaStatus?
  snapshot       Json               @default("{}") // metadata at time of action (status, actor)
  // docs/poa-rejection-categories/ (2026-08-13) — only set on REJECT rows,
  // always null otherwise (enforced at the application layer, see rejectDoctor
  // in poaWorkflow.ts). Typed enum column (not a snapshot JSON key) so future
  // "reject count by category" reporting can groupBy/filter directly.
  rejectCategory PoaRejectCategory?
  createdAt      DateTime           @default(now())

  poaId String
  poa   PoaForm @relation(fields: [poaId], references: [id])

  actorId String
  actor   User   @relation(fields: [actorId], references: [nip])

  // Set for per-doctor events (approve/reject/etc. targeting one doctor) —
  // null for draft-level events (CREATE, and any future non-doctor-scoped
  // action). See PoaDoctorApproval doc comment.
  doctorApprovalId String?
  doctorApproval   PoaDoctorApproval? @relation(fields: [doctorApprovalId], references: [id], onDelete: SetNull)

  @@index([poaId])
  @@index([actorId])
  @@index([doctorApprovalId])
}

// ─── Outlet Master Data ───────────────────────────────────────────────────────
// Synced from Struktur_Marketing_PI (Divisi KAM1, latest Periode).

model Outlet {
  kodePI       String  @id
  namaOutlet   String
  outCode      String?
  statusOutlet String? // 'A' = active, 'M' = merged/inactive
  namaChannel  String?
  groupRS      String? // e.g. "HERMINA GRUP", "NON CHAIN"
  sector       String?
  subSektor    String?
  kota         String?
  propinsi     String?
  kategori     String? // "KATEGORI OUTLET" A/B/C from Struktur Verified org file

  // Territory hierarchy (from org structure CSV)
  kodeGT   String?
  namaGT   String?
  kodeSub  String?
  namaSub  String?
  kodeArea String?
  namaArea String?
  kodeReg  String?
  namaReg  String?

  // Who can actually act on this specific outlet right now — normally its MR,
  // but if the MR (and any level between them and this person) is vacant,
  // this cascades up to the first active ASM/SM/NSM in that outlet's own
  // reporting chain. Recomputed by scripts/importStrukturVerifiedKAM.ts.
  // Drives canCreatePoa()'s "vacant team" exception — scoped to just the
  // specific outlets a manager covers this way, not their whole subtree.
  coveredByNip  String?
  coveredByRole String? // "MR" | "ASM" | "SM" | "NSM"

  // POA Standarisasi (docs/poa-standarisasi/, 2026-08-14) — sumber data belum
  // pasti (sync eksternal vs input manual, lihat 01-business-rules.md §7 Q8),
  // v1: nullable, diisi manual pertama kali oleh MR di form (lalu snapshot
  // independen di PoaStandarisasi.jumlahBedRs, tidak live-derive dari sini).
  jumlahBed Int?

  syncedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments           MrOutletAssignment[]
  customerOutlets       CustomerOutlet[]
  psspHospinetSnapshots PsspHospinetSnapshot[]
  surveyRekomendasi     SurveyRekomendasi[]
  surveyUploadLogs      SurveyUploadLog[]
  poaStandarisasi       PoaStandarisasi[]

  @@index([statusOutlet])
  @@index([sector])
}

// ─── Product Master Data ──────────────────────────────────────────────────────
// Synced from "LIST PRODUK PI" Excel file.

model Product {
  // "Kd Item" / "Item Kode" — sourced from TKT...LAPORAN HNA SARUASUBUR.xlsx.
  // Nilai R.xlsx and Kebutuhan Satuan Terkecil.xlsx key by this same code
  // natively, so no bridge/mapping file is needed for those syncs.
  kodeProduk              String   @id
  namaGroupBrand          String
  namaProduk              String
  zatAktif                String?
  satuan                  String // SJ (Satuan Jual), e.g. "BOX"
  hna                     Decimal  @db.Decimal(18, 2) // HNA per SJ
  nilaiRPersen            Decimal? @db.Decimal(10, 6) // NILAI_R / HNA from Nilai R.xlsx
  // Satuan Terkecil — from Kebutuhan Satuan Terkecil.xlsx
  satuanTerkecil          String? // Pack_Name, e.g. "TABLET", "BOTOL"
  konversiPembagi         Decimal? @db.Decimal(10, 2) // how many ST per SJ (e.g. 100 for tablet BOX 100's)
  // Dosis reference data — from "List Product pharos.xlsx" (sheets "Oral Product" / "Injeksi Product").
  // Keyed by that file's "PROCOD" column, which despite the name matches kodeProduk (Kd Item) directly.
  dosisKekuatanSediaan    String? // "Dosis/Kekuatan Sediaan"
  qtyPerRxPasien          Decimal? @db.Decimal(10, 2) // "Berapa banyak per Rx per Pasien (Satuan Terkecil)"
  lamaPemberianHari       Int? // "Lama pemberian Per Pasien (Hari)"
  jumlahPemberianPerHari  Decimal? @db.Decimal(10, 2) // "Jumlah pemberian Per hari (Satuan Terkecil)"
  bentukSediaan           String?
  packing                 String?
  indikasi                String?  @db.Text
  // Which medical specialties this product is recommended for — from
  // "internal/Rekomendasi Paket Produk Per Spesialisasi.xlsx", sheet
  // "Recommendation" (columns BEDAH..UROLOGY, "Y" marks a match), uppercased
  // column names (e.g. "BEDAH", "ANASTESI", "ORTHOPEDI", "GP &UGD",
  // "PEDIATRICT" — sic, matches the source header typo). Empty = product not
  // covered by that reference sheet (no specialty claim either way). Used to
  // filter the "Listing Corporate" sections in the Produk Rekomendasi panel
  // down to products relevant to the doctor's own spesialisasi — see
  // SPESIALISASI_TO_KOLOM_REKOMENDASI in src/lib/paketProduk.ts for the DB
  // spesialisasi -> these column names mapping (sourced from the same
  // workbook's Sheet2, column "REKOMENDASI PAKET DATA PAK LEEMAN").
  spesialisasiRekomendasi String[] @default([])
  syncedAt                DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  poaStandarisasiProduk PoaStandarisasiProduk[]

  @@index([namaGroupBrand])
}

// ─── PSSP Contract Data ───────────────────────────────────────────────────────
// One row per (C_URUT × KD_PRODUK). Imported from Pelunasan Excel snapshots.
// kdCust links to Customer.kodeCustomer for history lookup.

model PsspKontrak {
