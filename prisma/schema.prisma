generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  MR
  ASM
  SM
  NSM
  GM
  ADMIN
  SFE
}

enum PoaStatus {
  DRAFT
  SUBMITTED_TO_ASM
  APPROVED_BY_ASM
  SUBMITTED_TO_SM
  APPROVED_BY_SM
  SUBMITTED_TO_NSM
  APPROVED_BY_NSM
  REVISI
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REVISE
  REJECT
}

enum StatusStandarisasi {
  SUDAH_STANDARISASI
  PROSES_PENGAJUAN
  BELUM_STANDARISASI
  TIDAK_TAHU
}

enum JenisPssp {
  PSSP
  PSSP_RETENSI
  PSSP_PEREMAJAAN
  PSSP_PERPANJANGAN
}

// Which party the "% PSSP" figure on a line item belongs to — purely a
// display-label switch (2026-07-24 request): selecting KPDM renames "%
// PSSP User" to "% PSSP KPDM" in the form/exports, the field and formula
// underneath are unchanged (persenPsspDokter stays the one source of truth
// — see LineItemEditor.tsx history around persenPsspKpdm's removal).
enum PihakPssp {
  USER
  KPDM
}

// Simple PS/SP classification at doctor level — business meaning not yet
// pinned down at request time (2026-07-24); kept as a plain 2-value choice
// rather than folded into JenisPssp.
enum PsSp {
  PS
  SP
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  nip         String    @id
  name        String
  role        Role
  // Display-only override for what's SHOWN as this person's title (e.g. "SPV")
  // when their actual `role`/permissions are a lower level (SPV collapses to
  // MR everywhere in this app — same approval rights, same outlet-holding
  // rules — see scripts/importStrukturHospital.ts). Null means "just show role".
  jabatan     String?
  email       String?
  isActive    Boolean   @default(true)
  isDummy     Boolean   @default(false)  // workshop/demo account — bypasses outlet-assignment restrictions
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Territory assignment (derived from org structure CSV)
  // MR → GT, SPV (MR) → Sub, ASM → Area, SM → Reg
  kodeWilayah  String?
  namaWilayah  String?

  // Self-relation for org hierarchy
  nipAtasan    String?
  namaAtasan   String?
  reportsTo    User?    @relation("OrgHierarchy", fields: [nipAtasan], references: [nip])
  subordinates User[]   @relation("OrgHierarchy")

  // POA ownership
  ownedPoas    PoaForm[] @relation("PoaOwner")
  heldPoas     PoaForm[] @relation("PoaCurrentHolder")

  // Audit activity
  auditLogs    PoaAuditLog[]

  // Doctor registration submissions
  pengajuanCustomer CustomerPengajuan[] @relation("CustomerPengajuanSubmitter")

  // Outlet assignments (synced from MSSQL)
  outletAssignments MrOutletAssignment[]

  @@index([nipAtasan])
  @@index([role])
}

model PoaForm {
  id        String    @id @default(uuid())
  period    String    // e.g. "2026-07" — flexible, not locked to monthly
  status    PoaStatus @default(DRAFT)
  version   Int       @default(1)  // bumped every time it re-enters REVISI — "Version X" label
  target    Decimal?  @db.Decimal(18, 2)  // sales target in Rupiah set by atasan
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownerId   String
  owner     User      @relation("PoaOwner", fields: [ownerId], references: [nip])

  // Null in DRAFT (owner holds it implicitly) or once fully approved
  currentHolderId String?
  currentHolder   User?   @relation("PoaCurrentHolder", fields: [currentHolderId], references: [nip])

  auditLogs PoaAuditLog[]
  items     PoaLineItem[]

  @@index([ownerId])
  @@index([currentHolderId])
  @@index([status])
}

model Customer {
  id           String   @id @default(uuid())
  kodeCustomer String?  @unique
  namaCustomer String
  spesialisasi String
  syncedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outlets      CustomerOutlet[]
  psspHospinetSnapshots PsspHospinetSnapshot[]

  @@index([spesialisasi])
  @@index([namaCustomer])
}

model CustomerOutlet {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kodePI     String
  outlet     Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  isFokus    Boolean  @default(false)
  syncedAt   DateTime?

  @@unique([customerId, kodePI])
  @@index([kodePI])
  @@index([customerId])
  @@index([kodePI, isFokus])
}

// Customer-level PSSP snapshot for divisions not covered by PsspKontrak's
// contract-level import (e.g. Hospinet — see internal/TODO.md #40). Source
// files here have no contract number, no per-product breakdown, and no
// monthly detail — just one current lump value per customer×outlet — so
// this deliberately does NOT reuse PsspKontrak's shape (same reasoning as
// DiskonHistory vs DiskonKontrak: coarser fallback data gets its own model
// rather than fabricating fields PsspKontrak requires but the source lacks).
model PsspHospinetSnapshot {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kodePI         String
  outlet         Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  // Hospinet's own internal customer numbering (source "Kode Customer" column,
  // "0" means none) — a DIFFERENT namespace than Customer.kodeCustomer (the
  // main CDB code, alphanumeric like "F1045097"). Never write this into
  // Customer.kodeCustomer — customer identity here is still resolved by name.
  kodeCustomer   String?
  statusCustomer String   // "active-repeat" | "inactive-new"
  psspBerjalan   Boolean  // true when source "Terakhir PSSP" == "Berjalan"
  periodeAwal    String?  // YYYYMM, source "-" (no current/last PSSP period) → null
  periodeAkhir   String?  // YYYYMM, same null convention
  valuePssp      Decimal  @db.Decimal(18, 2)
  pelunasan      Decimal  @db.Decimal(18, 2)
  rr             Decimal? @db.Decimal(10, 4) // pelunasan / valuePssp, as given by source
  syncedAt       DateTime

  @@unique([customerId, kodePI])
  @@index([kodePI])
}

// Per-doctor×outlet×recommended-product survey row, from "17062026 Data
// Rekomendasi Final.xlsx" — for each (doctor, outlet) the survey matched a
// Pharos product by zat aktif/bentuk sediaan ("Kode Produk"/"Produk
// Rekomendasi"), and separately recorded what brand-level products that
// doctor has actually prescribed within that same category ("History
// Produk", e.g. "AZOMAX CAPLET FC 500MG 10 BLIS (88.8%); AZITHROMYCIN
// INFUSION VLS 500MG (7.9%)") — a mix of our own and competitor brands.
// Used to auto-suggest "Produk Kompetitor" on the POA form: when an MR
// picks a product in the dropdown that matches this row's kodeProduk, the
// non-Pharos entries in historyProduk are surfaced (see getKompetitorHistory
// in customer.ts). kodeCustomer/kodePI are matched by string against
// Customer.kodeCustomer/Outlet.kodePI at query time — not FK'd, since a
// doctor here doesn't need to already exist as a full Customer row.
model SurveyRekomendasi {
  id                     String   @id @default(uuid())
  kodePI                 String
  outlet                 Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  kodeCustomer           String   // "Kode Dokter" — same namespace as Customer.kodeCustomer, not FK'd
  namaCustomer           String
  kodeProduk             String   // Pharos's own recommended product for this doctor+category
  namaProdukRekomendasi  String
  zatAktif               String?
  dosageForm             String?
  kodeSpesialis          String?
  spesialis              String?
  potensiBulan           Decimal? @db.Decimal(10, 2)
  historyProduk          String   // raw "PRODUCT NAME (XX.X%); PRODUCT NAME (YY.Y%)" string
  statusSales            String?
  statusPssp             String?
  metodePemilihan        String?
  syncedAt               DateTime

  @@unique([kodePI, kodeCustomer, kodeProduk])
  @@index([kodePI, kodeCustomer])
}

model PoaLineItem {
  id     String  @id @default(uuid())
  poaId  String
  poa    PoaForm @relation(fields: [poaId], references: [id], onDelete: Cascade)

  // ── Customer group (auto-filled from Customer lookup) ────────────────────
  kodeRequest    String?  // legacy PSSP contract code — nullable
  kodeCust       String?  // Customer.kodeCustomer
  namaCust       String
  role           String   // e.g. "Dokter Spesialis"
  spesialisasi   String
  // True when namaCust came from a Customer the MR registered manually via
  // "Daftar User Baru" (Customer.syncedAt == null at line-item creation time),
  // not from the synced CDB. Flagged in the Excel exports so reviewers know
  // this doctor isn't yet in the official customer database.
  isManualCustomer Boolean @default(false)
  historisPSSP   String?
  kodePI         String?
  namaOutlet     String

  // ── Product group (auto-filled from kodeProduk lookup) ───────────────────
  kodeProduk            String
  namaProduk            String
  kategoriProdukFokus   String
  itemKode              String
  satuanTerkecil        String

  // ── MR manual input ───────────────────────────────────────────────────────
  labelCustomer         String?
  produkKompetitor      String?
  kriteriaProduk        String?
  statusStandarisasi    StatusStandarisasi?
  jenisPssp             JenisPssp?
  // Per-product — see PihakPssp doc comment above.
  pihakPssp             PihakPssp @default(USER)
  // Doctor-level (same value duplicated across all of one doctor's product
  // rows, same pattern as hariKerjaBulan/rencanaVisitMinggu below) — see
  // PsSp doc comment above.
  jenisPsSp             PsSp?

  // tentative fields (C20-C23) — nullable
  hariKerjaBulan   Int?
  jumlahPasienHari Int?
  jumlahResepHari  Int?
  qtyProdukResep   Int?

  lamaPeriode      Int     // 1, 3, 6, or 12
  periodeAwal      String  // YYYYMM
  // periodeAkhir is NOT stored — computed as periodeAwal + (lamaPeriode-1) months

  rencanaTotalBiaya   Decimal  @db.Decimal(18, 2)
  rencanaVisitMinggu  Int

  // ── Master data (auto from sync) ─────────────────────────────────────────
  nilaiR             Decimal?  @db.Decimal(18, 2)
  historySales3Bln   Decimal?  @db.Decimal(18, 2)
  avgDiskon          Decimal?  @db.Decimal(18, 4)

  // ── MR input per produk ───────────────────────────────────────────────────
  rasioEstimasiGrowth   Decimal?  @db.Decimal(18, 4)  // multiplier growth (e.g. 1.0 / 1.2)
  persenPsspDokter      Decimal?  @db.Decimal(18, 4)
  persenPsspKpdm        Decimal?  @db.Decimal(18, 4)
  persenDiskon          Decimal?  @db.Decimal(18, 4)
  persenDp              Decimal?  @db.Decimal(18, 4)
  persenListingFee      Decimal?  @db.Decimal(18, 4)
  persenEntertain       Decimal?  @db.Decimal(18, 4)

  // ── Formula placeholder columns (all nullable, computed externally) ───────
  hargaSatuanTerkecil           Decimal?  @db.Decimal(18, 2)
  estimasiPSSPBulan             Decimal?  @db.Decimal(18, 2)
  totalEstimasiPSSPBulan        Decimal?  @db.Decimal(18, 2)
  pengaliNilaiR                 Decimal?  @db.Decimal(18, 4)
  rekomendasiBiayaBulan         Decimal?  @db.Decimal(18, 2)
  totalRekomendasiBiayaBulan    Decimal?  @db.Decimal(18, 2)
  estimasiPSSPPeriode           Decimal?  @db.Decimal(18, 2)
  totalEstimasiPSSPPeriode      Decimal?  @db.Decimal(18, 2)
  rekomendasiBiayaPeriode       Decimal?  @db.Decimal(18, 2)
  totalRekomendasiBiayaPeriode  Decimal?  @db.Decimal(18, 2)
  rasioRekomenEstimasi          Decimal?  @db.Decimal(18, 4)
  rasioRencanaBiayaEstimasi     Decimal?  @db.Decimal(18, 4)
  totalPersenBudget             Decimal?  @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poaId])
  @@index([kodeRequest])
}

model PoaAuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  fromStatus PoaStatus?
  toStatus   PoaStatus?
  snapshot   Json        @default("{}")  // metadata at time of action (status, actor)
  createdAt  DateTime    @default(now())

  poaId   String
  poa     PoaForm @relation(fields: [poaId], references: [id])

  actorId String
  actor   User    @relation(fields: [actorId], references: [nip])

  @@index([poaId])
  @@index([actorId])
}

// ─── Outlet Master Data ───────────────────────────────────────────────────────
// Synced from Struktur_Marketing_PI (Divisi KAM1, latest Periode).

model Outlet {
  kodePI       String  @id
  namaOutlet   String
  outCode      String?
  statusOutlet String? // 'A' = active, 'M' = merged/inactive
  namaChannel  String?
  groupRS      String?  // e.g. "HERMINA GRUP", "NON CHAIN"
  sector       String?
  subSektor    String?
  kota         String?
  propinsi     String?
  kategori     String?  // "KATEGORI OUTLET" A/B/C from Struktur Verified org file

  // Territory hierarchy (from org structure CSV)
  kodeGT   String?
  namaGT   String?
  kodeSub  String?
  namaSub  String?
  kodeArea String?
  namaArea String?
  kodeReg  String?
  namaReg  String?

  // Who can actually act on this specific outlet right now — normally its MR,
  // but if the MR (and any level between them and this person) is vacant,
  // this cascades up to the first active ASM/SM/NSM in that outlet's own
  // reporting chain. Recomputed by scripts/importStrukturVerifiedKAM.ts.
  // Drives canCreatePoa()'s "vacant team" exception — scoped to just the
  // specific outlets a manager covers this way, not their whole subtree.
  coveredByNip  String?
  coveredByRole String?  // "MR" | "ASM" | "SM" | "NSM"

  syncedAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments      MrOutletAssignment[]
  customerOutlets  CustomerOutlet[]
  psspHospinetSnapshots PsspHospinetSnapshot[]
  surveyRekomendasi     SurveyRekomendasi[]

  @@index([statusOutlet])
  @@index([sector])
}

// ─── Product Master Data ──────────────────────────────────────────────────────
// Synced from "LIST PRODUK PI" Excel file.

model Product {
  // "Kd Item" / "Item Kode" — sourced from TKT...LAPORAN HNA SARUASUBUR.xlsx.
  // Nilai R.xlsx and Kebutuhan Satuan Terkecil.xlsx key by this same code
  // natively, so no bridge/mapping file is needed for those syncs.
  kodeProduk      String   @id
  namaGroupBrand  String
  namaProduk      String
  zatAktif        String?
  satuan          String            // SJ (Satuan Jual), e.g. "BOX"
  hna             Decimal  @db.Decimal(18, 2)   // HNA per SJ
  nilaiRPersen    Decimal? @db.Decimal(10, 6)   // NILAI_R / HNA from Nilai R.xlsx
  // Satuan Terkecil — from Kebutuhan Satuan Terkecil.xlsx
  satuanTerkecil  String?           // Pack_Name, e.g. "TABLET", "BOTOL"
  konversiPembagi Decimal? @db.Decimal(10, 2)   // how many ST per SJ (e.g. 100 for tablet BOX 100's)
  // Dosis reference data — from "List Product pharos.xlsx" (sheets "Oral Product" / "Injeksi Product").
  // Keyed by that file's "PROCOD" column, which despite the name matches kodeProduk (Kd Item) directly.
  dosisKekuatanSediaan   String?           // "Dosis/Kekuatan Sediaan"
  qtyPerRxPasien         Decimal? @db.Decimal(10, 2)   // "Berapa banyak per Rx per Pasien (Satuan Terkecil)"
  lamaPemberianHari      Int?              // "Lama pemberian Per Pasien (Hari)"
  jumlahPemberianPerHari Decimal? @db.Decimal(10, 2)   // "Jumlah pemberian Per hari (Satuan Terkecil)"
  bentukSediaan          String?
  packing                String?
  indikasi               String?  @db.Text
  syncedAt        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([namaGroupBrand])
}

// ─── PSSP Contract Data ───────────────────────────────────────────────────────
// One row per (C_URUT × KD_PRODUK). Imported from Pelunasan Excel snapshots.
// kdCust links to Customer.kodeCustomer for history lookup.

model PsspKontrak {
  id         String   @id @default(uuid())

  // Contract identity
  kdCust     String              // KD_CUST — links to Customer.kodeCustomer
  nmCust     String
  cUrut      String              // contract number
  kdSpc      String?
  nmSpc      String?
  role       String?
  nDivisi    Int?
  divKode    String?
  biaya      Decimal  @db.Decimal(18, 2)
  prdAwal    String              // YYYYMM
  prdAkhir   String              // YYYYMM
  nipUsul    String?
  nmUsul     String?
  kdOutlet   String?
  nmOutlet   String?
  divProd    String?
  kdProduk   String?
  nmProduk   String?

  // Computed scalars (from ETL)
  estBaris   Decimal? @db.Decimal(18, 2)
  bmBaris    Decimal? @db.Decimal(18, 2)

  // Pre-computed period totals (sum across all months)
  totalEst   Decimal? @db.Decimal(18, 2)
  totalBm    Decimal? @db.Decimal(18, 2)
  totalLunas Decimal? @db.Decimal(18, 2)

  // Per-period detail as JSONB: { "202501": 1475000, "202502": 1475000, ... }
  estByPeriod   Json @default("{}")
  bmByPeriod    Json @default("{}")
  lunasByPeriod Json @default("{}")

  snapshotDate DateTime?       // date of source Excel file
  importedAt   DateTime @default(now())

  @@unique([cUrut, kdProduk])
  @@index([kdCust])
  @@index([kdOutlet])
  @@index([prdAwal, prdAkhir])
}

model ListingFeeKontrak {
  id         String   @id @default(uuid())

  // Contract identity
  noreq      String              // request/contract number
  div        String?             // KML / KMP
  jenis      String?
  tglApprove DateTime?
  tglPpud    DateTime?
  noOr       String?

  kdCust     String              // KODE CUST — links to Customer.kodeCustomer
  nmCust     String
  kdOutlet   String?             // KODE PI
  nmOutlet   String?

  prdAwal    String              // YYYYMM
  prdAkhir   String              // YYYYMM

  value       Decimal  @db.Decimal(18, 2)  // total listing fee value
  targetSales Decimal? @db.Decimal(18, 2)

  kdProduk   String?
  nmProduk   String?
  nsm        String?

  // Per-period detail as JSONB: { "202604": 1234.56, ... }
  bmByPeriod         Json @default("{}")
  pctListingByPeriod Json @default("{}")

  snapshotDate DateTime?       // date of source Excel file
  importedAt   DateTime @default(now())

  @@unique([noreq, kdProduk])
  @@index([kdCust])
  @@index([kdOutlet])
  @@index([prdAwal, prdAkhir])
}

// ─── Struktur Baru (draft org restructure) ────────────────────────────────────
// Staging table for "Simulasi Hospital Struktur 2026 New.xlsx - Master.csv" —
// a DRAFT outlet→hierarchy mapping (GM > NSM > SM > ASM > SPV > PSR) proposed
// for the 2026 restructure. Names are matched to existing non-dummy Users by
// exact name (case-insensitive); *Nip is null when no confident match was found.
// Not wired into Outlet/MrOutletAssignment or the approval workflow yet — this
// is for review only until the restructure is confirmed final.

model OutletStrukturBaru {
  id         String  @id @default(uuid())
  kodePI     String
  namaOutlet String?
  area       String?

  gmNama  String?
  nsmNama String?
  smNama  String?
  asmNama String?
  spvNama String?
  psrNama String?

  gmNip  String?
  nsmNip String?
  smNip  String?
  asmNip String?
  spvNip String?
  psrNip String?

  importedAt DateTime @default(now())

  @@index([kodePI])
  @@index([gmNip])
  @@index([nsmNip])
  @@index([smNip])
  @@index([asmNip])
  @@index([spvNip])
  @@index([psrNip])
}

// Single-row tracker for "which month's org structure is currently loaded" —
// the source file changes every month with no self-declared period inside it,
// so scripts/importStrukturHospital.ts stamps the run date as the effective
// period each time it's re-run. Shown in the Admin page so staff always know
// how current the structure is without checking the DB directly.
model OrgStrukturMeta {
  id         Int      @id @default(1)
  periode    String   // YYYYMM
  sourceFile String
  importedAt DateTime @default(now())
}

// ─── DPL (Diskon Penjualan Langsung) Contract Data ────────────────────────────
// One row per (NOMOR contract × PRODUK). Imported from "DPL <bulan tahun>.xlsx"
// snapshots (sheet "DPL"). newOnPi is the effective/active on-invoice discount %
// used to auto-fill PoaLineItem.avgDiskon for contracts whose period is running.

model DiskonKontrak {
  id         String   @id @default(uuid())

  nomor      String              // NOMOR — contract number
  nmAreaPi   String?
  areaPi     String?
  kodePIRaw  String              // raw KODEPI from source sheet (numeric suffix only)
  kodePI     String              // areaPi + kodePIRaw — matches Outlet.kodePI
  namaOutlet String?
  bumn       String?
  divisi     String?

  prdAwal    String              // YYYYMM
  prdAkhir   String              // YYYYMM

  kodeProduk String
  namaProduk String?

  onPi    Decimal? @db.Decimal(10, 4)
  offPi   Decimal? @db.Decimal(10, 4)
  onDist  Decimal? @db.Decimal(10, 4)
  offDist Decimal? @db.Decimal(10, 4)
  qtyBon  Decimal? @db.Decimal(10, 2)
  qtyBuy  Decimal? @db.Decimal(10, 2)

  newOnPi Decimal? @db.Decimal(10, 4)   // effective on-invoice discount %, used for avgDiskon

  snapshotDate DateTime?       // date of source Excel file
  importedAt   DateTime @default(now())

  @@unique([nomor, kodeProduk])
  @@index([kodePI])
  @@index([kodeProduk])
  @@index([prdAwal, prdAkhir])
}

// Fallback discount source when no DiskonKontrak (DPL) covers an outlet+product —
// a weighted-average "% Total Diskon" per outlet+product derived from actual past
// invoices (see scripts/importDiskonHistory.ts). Not period-scoped like
// DiskonKontrak — this is a flat historical average across the whole source file.
model DiskonHistory {
  id           String   @id @default(uuid())
  kodePI       String
  kodeProduk   String
  avgDiskonPct Decimal  @db.Decimal(10, 4) // e.g. 7.75 for 7.75%, weighted by Gross Subtotal
  sourcePeriod String              // e.g. "202601-202604" — the invoice period range this covers
  syncedAt     DateTime

  @@unique([kodePI, kodeProduk])
  @@index([kodePI])
}

// ─── Customer Pengajuan ───────────────────────────────────────────────────────
// Submission form for registering a new doctor. On submit, Customer + CustomerOutlet
// records are created and customerId is populated.

model CustomerPengajuan {
  id              String    @id @default(uuid())

  // Step 1 — Informasi Umum
  namaLengkap     String
  namaPanggilan   String
  jabatan         String
  tipeCustomer    String    // "NEGERI" | "SWASTA"
  tanggalLahir    DateTime?
  jenisKelamin    String?   // "L" | "P"
  alamatRumah     String?
  kota            String?
  nik             String?
  email           String?
  nomorHp1        String
  nomorHp2        String?
  rekening        Json      @default("[]")  // [{pemilik, nomor, bank, relasi}]

  // Step 2 — Pendidikan, Spesialisasi & Organisasi
  universitasS1       String?
  spesialisasi        String
  universitasSpesialis String?
  subSpesialisasi     String?
  organisasi          Json   @default("[]")  // [{namaOrganisasi, jabatanOrganisasi}]

  // Step 3 — Outlet
  outletsPengajuan    Json   @default("[]")
  // [{kodePI, namaOutlet, jadwalPraktik: [{hari, mulai, selesai, jumlahPasien}]}]

  // Status & tracking
  status          String    @default("DRAFT")  // "DRAFT" | "SUBMITTED"
  submittedBy     String
  submitter       User      @relation("CustomerPengajuanSubmitter", fields: [submittedBy], references: [nip])

  // Populated after submit creates the Customer
  customerId      String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([submittedBy])
  @@index([status])
  @@index([spesialisasi])
}

// ─── Outlet Sales History ─────────────────────────────────────────────────────
// Synced from mkt_insight.dbo.DIR10001B. One row per (kodePI × itemKode).
// totalSales12Bln = SUM([Value Sales]) for the 12 completed months before current.

model OutletSalesHistory {
  id              String   @id @default(uuid())
  kodePI          String
  itemKode        String
  totalSales12Bln Decimal  @db.Decimal(18, 2)
  periodeFrom     String   // YYYYMM — start of 12-month window
  periodeTo       String   // YYYYMM — end of 12-month window
  syncedAt        DateTime

  @@unique([kodePI, itemKode])
  @@index([kodePI])
  @@index([itemKode])
}

// Monthly sales QUANTITY per outlet+product — feeds the quarterly target
// calculation (ratio + productivity-equalization engine, see
// src/lib/targetCalculation.ts). Quantity, not Rupiah value — targets in
// this scheme are unit-quantity based; Rupiah value is qty × HNA, derived
// on demand from Product.hna.
model OutletSalesMonthly {
  id       String   @id @default(uuid())
  kodePI   String
  itemKode String
  periode  String   // YYYYMM
  qty      Decimal  @db.Decimal(18, 2)
  syncedAt DateTime

  @@unique([kodePI, itemKode, periode])
  @@index([kodePI])
  @@index([itemKode])
  @@index([periode])
}

// Outlet-level (not per-product) monthly Rupiah sales value from
// mkt_insight.dbo.DIR10001B — feeds the Detail POA page's "Data Sales" card
// (Historis [tahun lalu] / Sales YTD / Growth YTD), scoped to whichever
// outlets the viewed POA's MR holds. Deliberately outlet-level only (not
// per-product like OutletSalesMonthly above) and covers a much wider window
// (full previous year through current YTD, not just a rolling 12 months) —
// see outletSalesValueMonthlySync.ts.
model OutletSalesValueMonthly {
  id         String   @id @default(uuid())
  // Not FK'd to Outlet — same as OutletSalesMonthly/OutletSalesHistory above,
  // this is raw source data and shouldn't reject rows for an outlet our
  // Outlet table hasn't synced yet.
  kodePI     String
  periode    String   // YYYYMM
  valueSales Decimal  @db.Decimal(18, 2)
  syncedAt   DateTime

  @@unique([kodePI, periode])
  @@index([kodePI])
  @@index([periode])
}

// Manual policy input ("Tambahan Target" in the source spreadsheet) — the
// per-month stretch increment an NSM/Admin sets for a product ahead of a
// quarter. The calculation engine derives everything else from sales data.
// Superseded 2026-07-21 by ProductTargetAllocation as the primary way targets
// get set (manual cascading NSM→SM→ASM→MR instead of this ratio/productivity
// algorithm) — kept for the existing "Simulasi Target Produk" reference view.
model ProductTargetInput {
  id          String   @id @default(uuid())
  kodeProduk  String
  quarter     String   // e.g. "2026-Q3" — matches PoaForm.period format
  monthlyRamp Decimal  @db.Decimal(18, 2)
  setBy       String?  // nip of the NSM/Admin who set it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kodeProduk, quarter])
}

// Manual per-product target, set by hand at EVERY org level, cascading
// NSM → SM (Area) → ASM → MR (2026-07-21, replaces the ratio+productivity
// algorithm above as the primary target-setting workflow — an admin sets an
// NSM's total first, then allocates it across that NSM's SMs, then each SM's
// total across its ASMs, then each ASM's total across its MRs). `nip` is
// whichever org-level person this row's qty belongs to; the level itself
// isn't stored here — it's implied by that NIP's own User.role. Enforcement
// that children sum to the parent's total is a UI-level nudge, not a DB
// constraint, since an admin may legitimately save a partial allocation
// mid-quarter and finish it later.
model ProductTargetAllocation {
  id         String   @id @default(uuid())
  kodeProduk String
  quarter    String   // e.g. "2026-Q3"
  nip        String   // NSM, SM, ASM, or MR nip — level implied by User.role
  qty        Decimal  @db.Decimal(18, 2)
  setBy      String?  // nip of the admin/NSM who last saved this row
  updatedAt  DateTime @updatedAt

  @@unique([kodeProduk, quarter, nip])
  @@index([kodeProduk, quarter])
  @@index([nip])
}

// Criteria tag per product per outlet — from ProductPMDatabase Unpivot sheets.
// Drives "produk fokus per outlet" logic in the POA form and stats panel.
model OutletProductKriteria {
  id              String   @id @default(uuid())
  kodePI          String
  kodeProduk      String
  paket           String   // e.g. "PAKET PENCERNAAN"
  kategori        String   // Low Hanging Fruit | Blue Ocean | Red Ocean
  kriteriaBaru    String   // e.g. "Produk Sudah Terstandarisasi - Ada Sales"
  statusTransaksi Int      // 0 or 1

  @@unique([kodePI, kodeProduk, paket])
  @@index([kodePI])
  @@index([kodeProduk])
}

// Junction: which MRs are assigned to which outlets per periode (from Struktur_Marketing_PI)
model MrOutletAssignment {
  id        String   @id @default(uuid())
  nipMR     String
  user      User     @relation(fields: [nipMR], references: [nip], onDelete: Cascade)
  kodePI    String
  outlet    Outlet   @relation(fields: [kodePI], references: [kodePI], onDelete: Cascade)
  periode   Int      // YYYYMM, e.g. 202607
  syncedAt  DateTime

  @@unique([nipMR, kodePI, periode])
  @@index([nipMR])
  @@index([kodePI])
  @@index([periode])
}
