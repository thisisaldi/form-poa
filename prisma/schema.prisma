// FALLBACK discount source, used ONLY when no DiskonKontrak (DPL) row above
// covers an outlet+product+period — the HIGHEST single-invoice "% Total
// Diskon" seen per outlet+product across past invoices. Imported via
// scripts/importDiskonHistory.ts from
// "internal/08062026 Data Diskon All Product Jan-Apr'26.xlsx" (sheet "Raw
// Data"); changed 2026-07-28 from a weighted average to max on business
// owner request. Not period-scoped like DiskonKontrak — this is a flat
// historical max across the whole source file.
model DiskonHistory {
  id           String   @id @default(uuid())
  kodePI       String
  kodeProduk   String
  maxDiskonPct Decimal  @db.Decimal(10, 4) // e.g. 7.75 for 7.75%, highest single invoice's % Total Diskon
  sourcePeriod String // e.g. "202601-202604" — the invoice period range this covers
  syncedAt     DateTime

  @@unique([kodePI, kodeProduk])
  @@index([kodePI])
}

// ─── Customer Pengajuan ───────────────────────────────────────────────────────
// Submission form for registering a new doctor. On submit, Customer + CustomerOutlet
// records are created and customerId is populated.

