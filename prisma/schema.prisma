  id String @id @default(uuid())

  // Step 1 — Informasi Umum
  namaLengkap   String
  namaPanggilan String
  jabatan       String
  tipeCustomer  String // "NEGERI" | "SWASTA"
  tanggalLahir  DateTime?
  jenisKelamin  String? // "L" | "P"
  alamatRumah   String?
  kota          String?
  nik           String?
  email         String?
  nomorHp1      String
  nomorHp2      String?
