# Template environment variables — copy ke .env.local (local) atau .env.staging
# Jangan isi nilai asli di file ini, file ini di-commit ke git

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?connection_limit=1&pool_timeout=20"

# MSSQL (untuk sync org structure & outlet — butuh VPN ke kantor)
MSSQL_CONNECTION_STRING="Server=HOST;Database=mkt_insight;User Id=USER;Password=PASS;Encrypt=false;TrustServerCertificate=true;"

# Session (generate: openssl rand -base64 32)
SESSION_SECRET=""

# Email
EMAIL_FROM="noreply@domain.com"
RESEND_API_KEY=""

# Sync secret (generate: openssl rand -hex 16)
SYNC_SECRET=""

# Exodus external API (Pharos) — visit history. Per-environment realm/URL,
# see Doc API Eksternal Activity. Client secret differs per environment too;
# get the right one from Vault (env/data/century/form-poa), never hardcode.
EXODUS_AUTH_URL="https://auth.pharos.id/realms/develop/protocol/openid-connect/token"
EXODUS_AUTH_CLIENT_ID="exodus-external"
EXODUS_AUTH_CLIENT_SECRET=""
EXODUS_API_BASE_URL="https://api.dev-pharos.my.id/exodus"

CANVASSER_API_BASE_URL="https://staging-izmo.chc.pharmalink.id/healthcare-productdetection/api"

# Google Drive upload (fitur "Input Data Survey") — service account credential
# JSON, base64-encoded. Get the real value from Vault (env/data/century/form-poa),
# never hardcode. Folder ID = shared drive folder tujuan upload survey.
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_DRIVE_SURVEY_FOLDER_ID=""

# App
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"
USE_MOCK_DB="false"

NEXUS_API_USERNAME=""
NEXUS_API_PASSWORD=""