# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Google service account credentials (secret — used to derive
# GOOGLE_SERVICE_ACCOUNT_KEY in .env.local, never commit the raw file)
service_account.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — semua .env* ter-ignore kecuali .env.example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal docs (not for version control)
AGENTS.md
CLAUDE.md
*.xlsx

# generated mock data (contains real customer/product data from Excel)
src/lib/mock/generated-data.json

# internal working folder (raw Excel source data + notes, not for version
# control). TODO.md used to live here as the one tracked exception — moved
# to docs/TODO.md 2026-08-03. /excel is a junction to /internal kept for
# scripts that still reference the old "excel/..." path
/internal/*
/excel

*.txt
dist
